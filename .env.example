# Governing: ADR-0003 (Serverless contact form delivery and external booking)
# Implements: SPEC-0001 REQ "Serverless Contact Form and Consultation Alternatives"

# Option A (Recommended): Web3Forms public access key (https://web3forms.com — free, sends to contact@futureware.ch)
PUBLIC_WEB3FORMS_KEY=

# Option B: Formspree form endpoint URL (e.g. https://formspree.io/f/xyzabcde)
PUBLIC_FORMSPREE_ENDPOINT=
