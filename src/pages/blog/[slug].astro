---
// Governing: ADR-0001 (Astro Content Collections), ADR-0002 (EN/DE routing)
// Implements: SPEC-0002 REQ "Localized Collection Listing and Detail Routes"
import BlogDetailPage from '@/components/pages/BlogDetailPage.astro';
import { extractEntrySlug, getPublishedBlogPosts } from '@/lib/content';

export async function getStaticPaths() {
  const entries = await getPublishedBlogPosts('en');
  return entries.map((entry) => ({
    params: { slug: extractEntrySlug(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<BlogDetailPage lang="en" entry={entry} />
