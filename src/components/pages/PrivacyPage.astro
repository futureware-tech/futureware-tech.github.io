---
// Governing: ADR-0001 (Astro + Tailwind static site), ADR-0002 (bilingual EN/DE routing), ADR-0003 (serverless contact & booking)
// Implements: SPEC-0001 REQ "Legal & Imprint Pages", REQ "Contact Form & Appointment Booking"
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE_CONFIG } from '@/config/site';
import { getTranslations, localePath, type Locale } from '@/i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const isDe = lang === 'de';
const { company } = SITE_CONFIG;
---

<BaseLayout
  lang={lang}
  title={t.meta.privacyTitle}
  description={t.meta.privacyDescription}
  canonicalPath={localePath(lang, '/privacy')}
  alternateEnPath={localePath('en', '/privacy')}
  alternateDePath={localePath('de', '/privacy')}
>
  <article class="relative py-20 md:py-28">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="mb-8">
        <a
          href={localePath(lang, '/')}
          class="inline-flex items-center gap-2 text-sm font-medium text-teal-400 transition-colors hover:text-teal-300"
        >
          <span aria-hidden="true">&larr;</span>
          {t.collections.backToHome}
        </a>
      </div>

      <header class="mb-12 border-b border-slate-800 pb-8">
        <p class="mb-2 font-mono text-xs uppercase tracking-widest text-teal-400">
          {isDe ? 'Datenschutz (nDSG / DSGVO)' : 'Privacy Notice (Swiss FADP / EU GDPR)'}
        </p>
        <h1
          id="main-heading"
          tabindex="-1"
          class="text-3xl font-extrabold tracking-tight text-white focus:outline-none sm:text-4xl"
        >
          {isDe ? 'Datenschutzerklärung' : 'Privacy Policy'}
        </h1>
        <p class="mt-3 text-sm text-slate-400">
          {isDe
            ? 'Gültig für das Online-Angebot von FutureWare GmbH unter futureware.ch.'
            : 'Applies to the online services of FutureWare GmbH at futureware.ch.'}
        </p>
      </header>

      <div class="space-y-10 text-slate-300 leading-relaxed">
        <section class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6 sm:p-8">
          <h2 class="mb-3 text-xl font-bold text-white">
            {isDe ? '1. Verantwortliche Stelle' : '1. Data Controller'}
          </h2>
          <p class="mb-4">
            {isDe
              ? 'Verantwortlich für die Bearbeitung personenbezogener Daten im Sinne des Schweizer Datenschutzgesetzes (nDSG) und – soweit anwendbar – der EU-Datenschutz-Grundverordnung (DSGVO) ist:'
              : 'The entity responsible for processing personal data under the Swiss Federal Act on Data Protection (FADP / nDSG) and, where applicable, the EU General Data Protection Regulation (GDPR) is:'}
          </p>
          <address class="not-italic text-slate-200">
            <p class="font-semibold text-white">{company.legalName}</p>
            <p>{company.street}</p>
            <p>
              {company.postalCode} {company.city}, {isDe ? company.countryDe : company.countryEn}
            </p>
            <p class="mt-2">
              {isDe ? 'E-Mail: ' : 'Email: '}
              <a
                href={`mailto:${company.email}`}
                class="text-teal-400 underline decoration-teal-500/40 underline-offset-4 hover:text-teal-300"
              >
                {company.email}
              </a>
            </p>
          </address>
        </section>

        <section class="space-y-3">
          <h2 class="text-xl font-bold text-white">
            {isDe
              ? '2. Statisches Hosting über GitHub Pages'
              : '2. Static Hosting via GitHub Pages'}
          </h2>
          <p>
            {isDe
              ? 'Diese Website wird als statische Webanwendung über GitHub Pages (GitHub, Inc. / GitHub B.V.) bereitgestellt. Beim Aufruf der Seiten werden durch die Infrastruktur von GitHub technisch notwendige Verbindungsdaten (z. B. IP-Adresse, Zeitpunkt des Zugriffs, angeforderte URL, User-Agent) in Server-Logfiles verarbeitet, um die Auslieferung, Stabilität und IT-Sicherheit zu gewährleisten.'
              : 'This website is hosted as a static site on GitHub Pages (GitHub, Inc. / GitHub B.V.). When you access our pages, GitHub infrastructure processes technically required connection metadata (such as IP address, timestamp, requested URL, and user agent) in server logs to deliver the site and maintain availability and security.'}
          </p>
        </section>

        <section class="space-y-3">
          <h2 class="text-xl font-bold text-white">
            {isDe
              ? '3. Keine Tracking-Cookies & lokal eingebettete Schriftarten'
              : '3. No Tracking Cookies & Self-Hosted Fonts'}
          </h2>
          <p>
            {isDe
              ? 'Wir setzen auf futureware.ch keine Analyse-, Werbe- oder Tracking-Cookies und keine Drittanbieter-Tracking-Skripte ein. Alle verwendeten Schriftarten (Inter Variable) sind lokal in das Website-Paket eingebunden; es findet kein Abruf externer Google-Fonts-Server statt.'
              : 'We do not use analytics, advertising, or tracking cookies or third-party tracking scripts on futureware.ch. All typography (Inter Variable) is self-hosted directly within the static site bundle, so no requests are sent to external font servers.'}
          </p>
        </section>

        <section class="space-y-3">
          <h2 class="text-xl font-bold text-white">
            {isDe
              ? '4. Kontaktformular und E-Mail-Anfragen'
              : '4. Contact Form & Email Inquiries'}
          </h2>
          <p>
            {isDe
              ? 'Wenn Sie uns über das Kontaktformular oder per E-Mail kontaktieren, bearbeiten wir die von Ihnen angegebenen Daten (Name, geschäftliche E-Mail-Adresse, optional Unternehmen und Nachrichteninhalt) ausschliesslich zur Prüfung und Beantwortung Ihrer Anfrage sowie für eine mögliche Projektdurchführung.'
              : 'When you reach out via our contact form or by email, we process the details you submit (name, work email address, optional company name, and inquiry message) solely to evaluate and respond to your inquiry and prepare any potential project collaboration.'}
          </p>
          <p>
            {isDe
              ? 'Sofern das serverlose Kontaktformular aktiv konfiguriert ist, wird Ihre Formulardaten-Übermittlung per HTTPS an den konfigurierten Formular-Endpunkt (Web3Forms oder Formspree) zur sicheren Zustellung an unser Postfach weitergeleitet. Bitte übermitteln Sie über das Kontaktformular keine besonders schützenswerten Personendaten oder vertraulichen Geschäftsgeheimnisse.'
              : 'When the serverless contact endpoint is configured, form submissions are transmitted over HTTPS to the configured form forwarding provider (Web3Forms or Formspree) solely to deliver your inquiry to our inbox. Please avoid including sensitive personal data or confidential trade secrets in initial contact messages.'}
          </p>
        </section>

        <section class="space-y-3">
          <h2 class="text-xl font-bold text-white">
            {isDe
              ? '5. Externe Terminbuchung (Google Calendar)'
              : '5. External Appointment Booking (Google Calendar)'}
          </h2>
          <p>
            {isDe
              ? 'Für die Buchung eines kostenlosen Erstgesprächs verlinken wir auf eine externe Terminbuchungsseite von Google Calendar (calendar.app.google). Erst wenn Sie aktiv auf diesen Link klicken, verlassen Sie unsere Website; ab diesem Zeitpunkt gelten die Datenschutzbestimmungen von Google.'
              : 'To book an introductory consultation, we link to an external Google Calendar appointment scheduling page (calendar.app.google). Only when you actively click that link do you leave our website, at which point Google’s privacy policy governs the scheduling interaction.'}
          </p>
        </section>

        <section class="space-y-3">
          <h2 class="text-xl font-bold text-white">
            {isDe ? '6. Aufbewahrungsdauer & Datensicherheit' : '6. Retention & Data Security'}
          </h2>
          <p>
            {isDe
              ? 'Wir speichern personenbezogene Daten aus Kontaktanfragen nur so lange, wie es für die Bearbeitung Ihrer Anfrage, die Erfüllung vertraglicher Pflichten oder gesetzliche Aufbewahrungsfristen erforderlich ist. Sämtliche Verbindungen zu dieser Website sind mittels HTTPS/TLS verschlüsselt.'
              : 'We retain personal data from inquiries only for as long as needed to process your request, fulfill contractual obligations, or comply with statutory retention periods. All connections to this website are encrypted using HTTPS/TLS.'}
          </p>
        </section>

        <section class="space-y-3">
          <h2 class="text-xl font-bold text-white">
            {isDe ? '7. Ihre Rechte' : '7. Your Rights'}
          </h2>
          <p>
            {isDe
              ? 'Nach dem Schweizer Datenschutzgesetz (nDSG) und – soweit anwendbar – der DSGVO haben Sie das Recht auf Auskunft über Ihre bei uns gespeicherten Daten, auf Berichtigung unrichtiger Daten, auf Löschung oder Einschränkung der Bearbeitung sowie auf Widerspruch und Datenherausgabe. Richten Sie entsprechende Anfragen bitte an '
              : 'Under the Swiss FADP (nDSG) and, where applicable, the EU GDPR, you have the right to request access to your personal data, rectification of inaccurate data, erasure or restriction of processing, objection, and data portability. Please send any privacy requests to '}
            <a
              href={`mailto:${company.email}`}
              class="text-teal-400 underline decoration-teal-500/40 underline-offset-4 hover:text-teal-300"
            >
              {company.email}
            </a>
            {isDe ? '.' : '.'}
          </p>
        </section>
      </div>
    </div>
  </article>
</BaseLayout>
