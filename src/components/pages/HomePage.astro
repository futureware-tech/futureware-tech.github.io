---
// Governing: ADR-0001 (Astro + Tailwind CSS), ADR-0002 (EN/DE routing and locale-invariant review), ADR-0003 (Serverless contact form and Google Calendar booking)
// Implements: SPEC-0001 REQ "Hero, Core Capabilities, and Value Proposition Sections", SPEC-0001 REQ "Customer Review Section", SPEC-0001 REQ "Serverless Contact Form and Consultation Alternatives"

import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_CONFIG } from '../../config/site';
import { getTranslations, localePath, type Locale } from '../../i18n/ui';
import ContactForm from '../ContactForm.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

const accentStyles = {
  brand: 'bg-brand-900/50 text-brand-400 border-brand-500/20',
  purple: 'bg-purple-900/50 text-purple-400 border-purple-500/20',
  green: 'bg-green-900/50 text-green-400 border-green-500/20',
  orange: 'bg-orange-900/50 text-orange-400 border-orange-500/20',
} as const;
---

<BaseLayout
  lang={lang}
  title={t.meta.homeTitle}
  description={t.meta.homeDescription}
  canonicalPath={localePath(lang, '/')}
  alternateEnPath={localePath('en', '/')}
  alternateDePath={localePath('de', '/')}
>
<section class="pt-20 pb-20 md:pt-32 md:pb-32 relative overflow-hidden">
  <div
    aria-hidden="true"
    class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[500px] opacity-20 pointer-events-none"
    style="background: radial-gradient(circle, #38bdf8 0%, transparent 60%);"
  ></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
    <h1
      id="main-heading"
      tabindex="-1"
      class="text-4xl md:text-6xl lg:text-7xl font-bold tracking-tight mb-6 focus:outline-none"
    >
      <span>{t.hero.titleLead}</span>
      <br />
      <span class="text-gradient">{t.hero.titleAccent}</span>
    </h1>

    <p class="mt-4 text-lg md:text-xl text-gray-300 max-w-3xl mx-auto mb-10">
      {t.hero.subtitle}
    </p>

    <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
      <a
        href="#services"
        class="inline-flex items-center justify-center min-h-12 px-8 py-4 rounded-full bg-gradient-brand text-white font-medium hover:shadow-lg hover:shadow-brand-500/30 transition-shadow w-full sm:w-auto"
      >
        {t.hero.primaryCta}
      </a>
      <a
        href={SITE_CONFIG.bookingUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center min-h-12 px-8 py-4 rounded-full bg-transparent border border-gray-600 text-white font-medium hover:bg-gray-800 hover:border-gray-400 transition-colors w-full sm:w-auto"
      >
        {t.hero.secondaryCta}
        <span class="visually-hidden"> {t.a11y.externalNewTab}</span>
      </a>
    </div>
  </div>
</section>

<section id="services" class="py-20 bg-gray-900/50 backdrop-blur-sm border-y border-gray-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">{t.services.heading}</h2>
      <p class="text-gray-400 max-w-2xl mx-auto">{t.services.subheading}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        t.services.items.map((service) => (
          <article class="bg-gray-950 p-8 rounded-2xl border border-gray-800 glow-card flex flex-col">
            <div
              class:list={[
                'w-12 h-12 rounded-lg flex items-center justify-center mb-6 border',
                accentStyles[service.accent],
              ]}
            >
              {service.id === 'local-ai' && (
                <svg aria-hidden="true" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                  <rect x="5" y="11" width="14" height="10" rx="2" />
                  <path stroke-linecap="round" d="M8 11V7a4 4 0 018 0v4" />
                  <circle cx="12" cy="16" r="1.25" fill="currentColor" />
                </svg>
              )}
              {service.id === 'rag-systems' && (
                <svg aria-hidden="true" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                  <rect x="4" y="4" width="11" height="13" rx="2" />
                  <rect x="9" y="8" width="11" height="12" rx="2" />
                  <path stroke-linecap="round" d="M12 12h5M12 15.5h5" />
                </svg>
              )}
              {service.id === 'task-automation' && (
                <svg aria-hidden="true" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 3L5 14h6l-1 7 9-11h-6l0-7z" />
                </svg>
              )}
              {service.id === 'custom-agents' && (
                <svg aria-hidden="true" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h12a2 2 0 012 2v8a2 2 0 01-2 2H9l-5 4V6z" />
                  <circle cx="9" cy="10" r="1" fill="currentColor" />
                  <circle cx="15" cy="10" r="1" fill="currentColor" />
                </svg>
              )}
            </div>

            <h3 class="text-xl font-semibold mb-3 text-white">{service.title}</h3>
            <p class="text-gray-400 flex-grow leading-relaxed">{service.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section id="benefits" class="py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row gap-12 items-center">
      <div class="lg:w-1/2">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">
          {t.benefits.headingPrefix}{' '}
          <span class="text-brand-400">{t.benefits.headingBrand}</span>{t.benefits.headingSuffix}
        </h2>
        <ul role="list" class="space-y-6">
          {
            t.benefits.items.map((benefit) => (
              <li class="flex items-start">
                <div class="flex-shrink-0 w-8 h-8 rounded-full bg-brand-900/50 flex items-center justify-center text-brand-400 mt-1">
                  <svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <div class="ms-4">
                  <h3 class="text-lg font-semibold text-white">{benefit.title}</h3>
                  <p class="text-gray-400 mt-1 leading-relaxed">{benefit.description}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lg:w-1/2 w-full">
        <div
          role="img"
          aria-label={t.benefits.visualCaption}
          class="relative w-full aspect-square md:aspect-[4/3] rounded-2xl overflow-hidden border border-gray-800 bg-gray-900 group"
        >
          <div
            aria-hidden="true"
            class="absolute inset-0 bg-gradient-brand opacity-10 group-hover:opacity-20 transition-opacity duration-500 z-10"
          ></div>
          <div aria-hidden="true" class="absolute inset-0 flex items-center justify-center">
            <div class="relative w-32 h-32">
              <div class="orbit-ring-cw absolute inset-0 rounded-full border border-brand-500/30"></div>
              <div class="orbit-ring-ccw absolute inset-2 rounded-full border border-purple-500/30"></div>
              <div class="absolute inset-0 flex items-center justify-center text-brand-400">
                <svg class="w-10 h-10" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <rect x="4" y="5" width="16" height="5" rx="1.5" />
                  <rect x="4" y="14" width="16" height="5" rx="1.5" />
                  <circle cx="8" cy="7.5" r="0.8" fill="currentColor" />
                  <circle cx="8" cy="16.5" r="0.8" fill="currentColor" />
                </svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="testimonials" class="py-20 bg-gray-900/40 backdrop-blur-sm border-t border-gray-800">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl md:text-4xl font-bold mb-3">{t.testimonial.heading}</h2>
    <p class="text-gray-400 mb-12">{t.testimonial.subheading}</p>

    <figure class="bg-gray-950 p-8 md:p-12 rounded-2xl border border-gray-800 glow-card relative">
      <div aria-hidden="true" class="flex justify-center gap-1.5 text-brand-400 mb-6 text-lg">
        <span>&#9733;</span>
        <span>&#9733;</span>
        <span>&#9733;</span>
        <span>&#9733;</span>
        <span>&#9733;</span>
      </div>

      <blockquote
        cite={SITE_CONFIG.testimonial.websiteUrl}
        lang="de"
        class="text-xl md:text-2xl font-medium text-gray-100 leading-relaxed mb-6"
      >
        <p>&bdquo;{SITE_CONFIG.testimonial.quoteDe}&ldquo;</p>
      </blockquote>

      <figcaption class="flex flex-col sm:flex-row items-center justify-center gap-2 text-sm text-gray-400">
        <span class="font-semibold text-white">{SITE_CONFIG.testimonial.author}</span>
        <span aria-hidden="true" class="hidden sm:inline text-gray-600">&middot;</span>
        <cite class="not-italic">
          <a
            href={SITE_CONFIG.testimonial.websiteUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-brand-400 hover:text-brand-100 transition-colors underline underline-offset-4"
          >
            {SITE_CONFIG.testimonial.websiteLabel}
            <span class="visually-hidden"> {t.a11y.externalNewTab}</span>
          </a>
        </cite>
      </figcaption>
    </figure>
  </div>
</section>

<section id="contact" class="py-20 bg-gray-900/80 backdrop-blur-sm border-t border-gray-800">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl md:text-4xl font-bold mb-4">{t.contact.heading}</h2>
    <p class="text-gray-400 mb-8">{t.contact.subheading}</p>

    <ContactForm lang={lang} />
  </div>
</section>
</BaseLayout>
