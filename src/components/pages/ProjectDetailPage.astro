---
// Governing: ADR-0001 (Astro Content Collections), ADR-0002 (EN/DE subpath routing and cross-locale linking)
// Implements: SPEC-0002 REQ "Localized Collection Listing and Detail Routes", REQ "Cross-Locale Entry Linking"
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE_CONFIG } from '@/config/site';
import { getTranslations, localePath, type Locale } from '@/i18n/ui';
import { extractEntrySlug, resolveCollectionTranslationPath } from '@/lib/content';

interface Props {
  lang: Locale;
  entry: CollectionEntry<'projects'>;
}

const { lang, entry } = Astro.props;
const t = getTranslations(lang);
const { Content } = await render(entry);

const slug = extractEntrySlug(entry.id);
const currentPath = localePath(lang, `/projects/${slug}`);
const targetLang: Locale = lang === 'en' ? 'de' : 'en';
const translation = await resolveCollectionTranslationPath('projects', entry, targetLang);

const alternateEnPath =
  lang === 'en'
    ? currentPath
    : translation.hasExactTranslation
      ? translation.path
      : null;

const alternateDePath =
  lang === 'de'
    ? currentPath
    : translation.hasExactTranslation
      ? translation.path
      : null;

const switchEnHref = lang === 'en' ? currentPath : translation.path;
const switchDeHref = lang === 'de' ? currentPath : translation.path;

const dateFormatter = new Intl.DateTimeFormat(lang === 'de' ? 'de-CH' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  lang={lang}
  title={`${entry.data.title} | Futureware`}
  description={entry.data.description}
  canonicalPath={currentPath}
  alternateEnPath={alternateEnPath}
  alternateDePath={alternateDePath}
  switchEnHref={switchEnHref}
  switchDeHref={switchDeHref}
>
  <article class="relative py-20 md:py-28">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="mb-8">
        <a
          href={localePath(lang, '/projects')}
          class="inline-flex items-center gap-2 text-sm font-medium text-teal-400 transition-colors hover:text-teal-300"
        >
          <span aria-hidden="true">&larr;</span>
          {t.collections.backToProjects}
        </a>
      </div>

      <header class="mb-10 border-b border-slate-800 pb-8">
        <div class="mb-4 flex flex-wrap items-center gap-3 text-sm text-slate-400">
          <span>
            {t.collections.publishedOn}{' '}
            <time datetime={entry.data.pubDate.toISOString()}>
              {dateFormatter.format(entry.data.pubDate)}
            </time>
          </span>
          {
            entry.data.updatedDate && (
              <span>
                &middot; {t.collections.updatedOn}{' '}
                <time datetime={entry.data.updatedDate.toISOString()}>
                  {dateFormatter.format(entry.data.updatedDate)}
                </time>
              </span>
            )
          }
        </div>

        <h1
          id="main-heading"
          tabindex="-1"
          class="text-3xl font-extrabold tracking-tight text-white focus:outline-none sm:text-4xl lg:text-5xl"
        >
          {entry.data.title}
        </h1>

        <p class="mt-4 text-lg leading-relaxed text-slate-300">
          {entry.data.description}
        </p>

        {
          (entry.data.client || entry.data.industry || entry.data.services.length > 0) && (
            <dl class="mt-8 grid gap-4 rounded-2xl border border-slate-800 bg-slate-900/60 p-6 sm:grid-cols-3">
              {entry.data.client && (
                <div>
                  <dt class="text-xs font-semibold uppercase tracking-wider text-slate-400">
                    {t.collections.clientLabel}
                  </dt>
                  <dd class="mt-1 font-medium text-white">{entry.data.client}</dd>
                </div>
              )}
              {entry.data.industry && (
                <div>
                  <dt class="text-xs font-semibold uppercase tracking-wider text-slate-400">
                    {t.collections.industryLabel}
                  </dt>
                  <dd class="mt-1 font-medium text-white">{entry.data.industry}</dd>
                </div>
              )}
              {entry.data.services.length > 0 && (
                <div>
                  <dt class="text-xs font-semibold uppercase tracking-wider text-slate-400">
                    {t.nav.services}
                  </dt>
                  <dd class="mt-1 font-medium text-teal-300">
                    {entry.data.services.join(', ')}
                  </dd>
                </div>
              )}
            </dl>
          )
        }

        {
          entry.data.outcomes.length > 0 && (
            <div class="mt-6 rounded-2xl border border-teal-500/20 bg-teal-500/5 p-6">
              <h2 class="mb-3 text-sm font-semibold uppercase tracking-wider text-teal-400">
                {t.collections.outcomesLabel}
              </h2>
              <ul class="space-y-2 text-sm text-slate-200">
                {entry.data.outcomes.map((outcome) => (
                  <li class="flex items-start gap-2.5">
                    <span class="mt-0.5 text-teal-400" aria-hidden="true">&#10003;</span>
                    <span>{outcome}</span>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </header>

      <div class="prose prose-invert prose-slate max-w-none prose-headings:text-white prose-a:text-teal-400 hover:prose-a:text-teal-300 prose-strong:text-white prose-code:text-teal-300">
        <Content />
      </div>

      <aside class="mt-14 rounded-2xl border border-slate-800 bg-slate-900/70 p-8">
        <h2 class="text-xl font-bold text-white">
          {t.collections.articleCtaHeading}
        </h2>
        <p class="mt-2 text-slate-300">
          {t.collections.articleCtaBody}
        </p>
        <div class="mt-6 flex flex-wrap gap-4">
          <a
            href={SITE_CONFIG.bookingUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-xl bg-teal-500 px-6 py-3 text-sm font-semibold text-slate-950 transition-colors hover:bg-teal-400"
          >
            {t.contact.bookCallButton}
            <span class="sr-only"> {t.a11y.externalNewTab}</span>
          </a>
          <a
            href={`${localePath(lang, '/')}#contact`}
            class="inline-flex items-center justify-center rounded-xl border border-slate-700 bg-slate-900 px-6 py-3 text-sm font-semibold text-slate-100 transition-colors hover:border-teal-400 hover:text-teal-300"
          >
            {t.nav.contact}
          </a>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
